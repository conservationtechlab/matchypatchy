#!/bin/sh
set -e

INSTALL_DIR="/opt/matchypatchy"
WRAPPER="/usr/local/bin/matchypatchy"
DESKTOP="/usr/share/applications/matchypatchy.desktop"

if [ -f "$INSTALL_DIR/install.command" ]; then
  chmod 0755 "$INSTALL_DIR/install.command"
fi
if [ -f "$INSTALL_DIR/install.sh" ]; then
  chmod 0755 "$INSTALL_DIR/install.sh"
fi
if [ -f "$INSTALL_DIR/launcher.sh" ]; then
  chmod 0755 "$INSTALL_DIR/launcher.sh"
fi
if [ -f "$INSTALL_DIR/uninstall.sh" ]; then
  chmod 0755 "$INSTALL_DIR/uninstall.sh"
fi
if [ -d "$INSTALL_DIR/python_env" ]; then
  chmod -R a+r "$INSTALL_DIR/python_env"
fi
if [ -f "$WRAPPER" ]; then
  chmod 0755 "$WRAPPER"
fi
if [ -f "$DESKTOP" ]; then
  chmod 0644 "$DESKTOP"
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications || true
  fi
fi

exit 0
